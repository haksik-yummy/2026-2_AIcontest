# ===== Data =====
# 경진대회 데이터와 그 자료로 만든 파일은 커밋하지 않음
/data/*
!/data/.gitkeep
*.zip
/dist/

# 제출 사이트에만 올리는 파일 (설명 문서, 발표자료, 데모영상)
*.pdf
*.docx
*.pptx
*.mp4
/demo/
/docs/report.md
/figures/risk_atlas_example.jpg

# 지도 코드의 제공 자료 사본과 그 자료가 들어간 산출물
jeonbuk_map_code/bundle/
jeonbuk_map_code/data/
jeonbuk_map_code/output/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# ===== Secrets =====
.env
*.pem
*.key

